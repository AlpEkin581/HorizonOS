{
  "manifest_version": 3,
  "name": "HorizonOS Terminal",
  "version": "1.2.0",
  "description": "HorizonOS — Gerçek sistem bilgilerinizi gösteren terminal simülatörü.",
  "permissions": [
    "system.cpu",
    "system.memory",
    "system.storage",
    "system.display"
  ],
  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HorizonOS Terminal"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}